{
  "name": "svelte-datatable",
  "version": "1.4.2",
  "description": "A performant, accessible data table component for Svelte applications",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && svelte-package",
    "test": "vitest",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/package": "^2.2.0",
    "@testing-library/svelte": "^4.0.0",
    "eslint": "^8.56.0",
    "svelte": "^4.2.0",
    "svelte-check": "^3.6.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "keywords": ["svelte", "datatable", "table", "data-grid", "accessible"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DrOctoPunk/svelte-datatable"
  }
}